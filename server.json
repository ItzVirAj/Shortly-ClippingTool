{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ItzVirAj/Shortly-ClippingTool",
  "description": "Turn long videos into viral vertical shorts and publish them to TikTok, Instagram and YouTube.",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/ItzVirAj/Shortly-ClippingTool",
  "repository": {
    "url": "https://github.com/ItzVirAj/Shortly-ClippingTool",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://localhost:8000/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <API key>.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
